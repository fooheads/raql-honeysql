{:paths ["src"]
 :deps
 {com.fooheads/tolk                      {:mvn/version "0.9.0"}
  com.fooheads/raql                      {:mvn/version "0.9.8"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps
   {camel-snake-kebab/camel-snake-kebab  {:mvn/version "0.4.3"}
    com.fooheads/chinook-edn             {:mvn/version "0.1.12"}
    com.fooheads/stdlib                  {:mvn/version "0.4.0"}
    com.fooheads/test                    {:mvn/version "0.1.4"}
    com.github.seancorfield/honeysql     {:mvn/version "2.4.1066"}
    org.hsqldb/hsqldb                   {:mvn/version "2.7.4"}
    io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :test/local
  {:override-deps {com.fooheads/raql {:local/root "../raql"}}}

  :test/integration
  {:extra-paths ["integration-test"]
   :extra-deps
   {org.postgresql/postgresql          {:mvn/version "42.7.8"}
    com.microsoft.sqlserver/mssql-jdbc {:mvn/version "12.10.2.jre11"}}
   :exec-args {:dirs ["integration-test"]}}

  :build
  {:deps {com.fooheads/build-clj {:mvn/version "1.0.0"}}
   :ns-default fooheads.build}}}
